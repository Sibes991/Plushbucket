<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into the app's manifest. Health Connect needs: the read permission, visibility of the
     Health Connect app (Android 13 and older), and a screen that explains how the data is used
     (it opens the privacy policy) for both the old and the Android 14+ permission screens. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application>
        <activity
            android:name="com.plushbucket.healthrides.PrivacyPolicyActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name="com.plushbucket.healthrides.ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity="com.plushbucket.healthrides.PrivacyPolicyActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
